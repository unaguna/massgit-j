{
  "name": "massgit",
  "description": "massgit -- a tool that enables you to perform the same operation on multiple Git repositories with a single command execution.",
  "usages": [
    "%s [<options>] <subcommand> [<args>]",
    "%s (--version | --help)"
  ],
  "options": [
    {
      "names": ["--marker", "-m"],
      "type": "String",
      "dest": "marker_condition",
      "description": "Specify target repositories by marker. You can specify boolean expression such as 'marker1 or marker2'."
    },
    {
      "names": ["--rep-suffix"],
      "type": "String",
      "dest": "rep_suffix",
      "description": "The suffix of repository name in output. Default is ': ' in almost every subcommand."
    },
    {
      "names": ["--version"],
      "type": null,
      "dest": null,
      "description": "Show version number of massgit"
    }
  ],
  "subcommands": [
    {
      "name": "mg-clone",
      "subdesc": "Clone repositories written in repos.json.",
      "usages": [
        "%s [<options>] mg-clone",
        "%s mg-clone --help"
      ],
      "options": [
      ]
    },
    {
      "name": "mg-marker",
      "subdesc": "",
      "usages": [
        "%s [<options>] mg-marker list [<repo>...]",
        "%s [<options>] mg-marker edit <options-for-subcommand>[...] [<repo>...]",
        "%s mg-marker --help"
      ],
      "options": [
      ]
    },
    {
      "name": "mg-marker list",
      "subdesc": "",
      "usages": [
        "%s [<options>] mg-marker list [<repo>...]",
        "%s mg-marker list --help"
      ],
      "options": [
      ]
    },
    {
      "name": "mg-marker edit",
      "subdesc": "",
      "usages": [
        "%s [<options>] mg-marker edit <options-for-subcommand>[...] [<repo>...]",
        "%s mg-marker edit --help"
      ],
      "options": [
        {
          "names": ["--add", "-a"],
          "type": "String",
          "dest": "marker",
          "description": "Add specified marker into target repositories."
        },
        {
          "names": ["--remove", "-r"],
          "type": "String",
          "dest": "marker",
          "description": "Remove specified marker from target repositories."
        }
      ]
    },
    {
      "name": "<git-subcommand>",
      "subdesc": "Execute the subcommand for repositories.",
      "usages": [
        "%s [<options>] <git-subcommand> [<args>]"
      ],
      "options": [
      ]
    }
  ]
}

{
  "version": 2,
  "name": "massgit",
  "description": "massgit -- a tool that enables you to perform the same operation on multiple Git repositories with a single command execution.",
  "sections": [
    {
      "name": "usage",
      "header": "Usage:",
      "type": "Regular",
      "items": [
        {
          "left": "%s [<options>] <subcommand> [<args>]"
        },
        {
          "left": "%s (--version | --help)"
        }
      ]
    },
    {
      "name": "options",
      "header": "Options:",
      "type": "Options",
      "options": [
        {
          "names": ["--marker", "-m"],
          "type": "String",
          "dest": "marker_condition",
          "description": "Specify target repositories by marker. You can specify boolean expression such as 'marker1 or marker2'."
        },
        {
          "names": ["--rep-suffix"],
          "type": "String",
          "dest": "rep_suffix",
          "description": "The suffix of repository name in output. Default is ': ' in almost every subcommand."
        },
        {
          "names": ["--version"],
          "type": null,
          "dest": null,
          "description": "Show version number of massgit"
        }
      ]
    },
    {
      "name": "subcommands",
      "header": "Subcommands:",
      "type": "Subcommands"
    }
  ],
  "subcommands": [
    {
      "name": "mg-clone",
      "subdesc": "Clone repositories written in repos.json.",
      "sections": [
        {
          "name": "usage",
          "header": "Usage:",
          "type": "Regular",
          "items": [
            {
              "left": "%s [<options>] mg-clone"
            },
            {
              "left": "%s mg-clone --help"
            }
          ]
        }
      ]
    },
    {
      "name": "mg-marker",
      "subdesc": "",
      "sections": [
        {
          "name": "usage",
          "header": "Usage:",
          "type": "Regular",
          "items": [
            {
              "left": "%s [<options>] mg-marker list [<repo>...]"
            },
            {
              "left": "%s [<options>] mg-marker edit <options-for-subcommand>[...] [<repo>...]"
            },
            {
              "left": "%s mg-marker --help"
            }
          ]
        }
      ]
    },
    {
      "name": "mg-marker list",
      "subdesc": "",
      "sections": [
        {
          "name": "usage",
          "header": "Usage:",
          "type": "Regular",
          "items": [
            {
              "left": "%s [<options>] mg-marker list [<repo>...]"
            },
            {
              "left": "%s mg-marker list --help"
            }
          ]
        }
      ]
    },
    {
      "name": "mg-marker edit",
      "subdesc": "",
      "sections": [
        {
          "name": "usage",
          "header": "Usage:",
          "type": "Regular",
          "items": [
            {
              "left": "%s [<options>] mg-marker edit <options-for-subcommand>[...] [<repo>...]"
            },
            {
              "left": "%s mg-marker edit --help"
            }
          ]
        },
        {
          "name": "options",
          "header": "Options:",
          "type": "Options",
          "options": [
            {
              "names": ["--add", "-a"],
              "type": "String",
              "dest": "marker",
              "description": "Add specified marker into target repositories."
            },
            {
              "names": ["--remove", "-r"],
              "type": "String",
              "dest": "marker",
              "description": "Remove specified marker from target repositories."
            }
          ]
        }
      ]
    },
    {
      "name": "<git-subcommand>",
      "subdesc": "Execute the subcommand for repositories.",
      "sections": [
        {
          "name": "usage",
          "header": "Usage:",
          "type": "Regular",
          "items": [
            {
              "left":  "%s [<options>] <git-subcommand> [<args>]"
            }
          ]
        }
      ]
    }
  ]
}
